local function connect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(connections, c)
    return c
end
local function unwatch(player)
    if watchers[player] then
        for _, c in ipairs(watchers[player]) do c:Disconnect() end
        watchers[player] = nil
    end
end
local function clearVisual(player)
    local v = visuals[player]
    if v then v.highlight:Destroy(); v.billboard:Destroy(); visuals[player] = nil end
end
local unload
unload = function()
    if unloaded then return end
    unloaded, ready = true, false
    RunService:UnbindFromRenderStep(BIND)
    for _, c in ipairs(connections) do c:Disconnect() end
    for _, tween in ipairs(tweens) do tween:Cancel() end
    local list = {}
    for p in pairs(watchers) do table.insert(list, p) end
    for _, p in ipairs(list) do unwatch(p) end
    list = {}
    for p in pairs(visuals) do table.insert(list, p) end
    for _, p in ipairs(list) do clearVisual(p) end
