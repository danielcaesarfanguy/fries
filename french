    local rayParams=RaycastParams.new()
    rayParams.FilterType=Enum.RaycastFilterType.Exclude
    local function bodyParts(c)
        local parts={}
        for _,part in ipairs(c:GetChildren()) do
            if part:IsA("BasePart") and part.Name~="HumanoidRootPart" then table.insert(parts,part) end
        end
        local root=c:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then table.insert(parts,root) end
        return parts
    end
    local function preferredPart(c)
        local part
        if cfg.Part=="Head" then part=c:FindFirstChild("Head")
        elseif cfg.Part=="Torso" then part=c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("LowerTorso")
        elseif cfg.Part=="Root" then part=c:FindFirstChild("HumanoidRootPart") end
        return part and part:IsA("BasePart") and part or nil
    end
    local function scorePoint(camera,center,player,part)
        if not part or not part.Parent or not part:IsDescendantOf(player.Character) then return nil end
        local screen,onScreen=camera:WorldToViewportPoint(part.Position)
        if not onScreen or screen.Z<=0 then return nil end
        local screenDistance=(Vector2.new(screen.X,screen.Y)-center).Magnitude
        if screenDistance>cfg.FOV then return nil end
        if cfg.Wall then
            local hit=workspace:Raycast(camera.CFrame.Position,part.Position-camera.CFrame.Position,rayParams)
            if hit and not hit.Instance:IsDescendantOf(player.Character) then return nil end
        end
        return screenDistance
    end
    local function choosePart(camera,center,player)
        local c=player.Character
        if not c then return nil,nil end
        if cfg.Part~="Closest part" then
            local preferred=preferredPart(c)
            local score=preferred and scorePoint(camera,center,player,preferred)
            if score then return preferred,score end
            if not cfg.Adaptive then return nil,nil end
        end
        local best,bestScore=nil,math.huge
        for _,part in ipairs(bodyParts(c)) do
            local score=scorePoint(camera,center,player,part)
            if score and score<bestScore then best,bestScore=part,score end
        end
        return best,bestScore
    end
    local function findTarget(camera,center)
        local best,bestScore=nil,math.huge
        local myRoot=me.Character and me.Character:FindFirstChild("HumanoidRootPart")
        for _,player in ipairs(Players:GetPlayers()) do
            if eligible(player) then
                local part,score=choosePart(camera,center,player)
                if part then
                    if cfg.Priority=="Distance" then
                        score=(part.Position-(myRoot and myRoot.Position or camera.CFrame.Position)).Magnitude
                    end
                    if score<bestScore then best,bestScore={player=player,part=part},score end
                end
            end
        end
        return best
    end
    local lastStatus
    local function setStatus(message,active)
