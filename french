                    name.TextStrokeColor3=Color3.new(0,0,0); name.TextStrokeTransparency=0.25
                    v={character=c,highlight=highlight,billboard=billboard,label=name}; visuals[player]=v
                end
                local chunks={}
                if cfg.Names then table.insert(chunks,player.DisplayName) end
                if cfg.Distance and myRoot then table.insert(chunks,tostring(math.floor((c.HumanoidRootPart.Position-myRoot.Position).Magnitude)).." studs") end
                v.label.Text=table.concat(chunks,"  ·  ")
                v.billboard.Enabled=#chunks>0
            end
        end
        local stale={}
        for player in pairs(visuals) do if not active[player] then table.insert(stale,player) end end
        for _,player in ipairs(stale) do clearVisual(player) end
    end
    local function watch(player)
        if watchers[player] or departing[player] then return end
        local list={}; watchers[player]=list
        table.insert(list,player.CharacterAdded:Connect(function()
            if unloaded or departing[player] then return end
            retiring[player]=nil; clearVisual(player); updateVisuals()
        end))
        table.insert(list,player.CharacterRemoving:Connect(function(c)
            retiring[player]=c; clearVisual(player)
            if locked and locked.player==player then locked=nil end
        end))
        table.insert(list,player:GetPropertyChangedSignal("Team"):Connect(updateVisuals))
        table.insert(list,player:GetPropertyChangedSignal("Neutral"):Connect(updateVisuals))
    end
    connect(Players.PlayerAdded,function(player) departing[player]=nil; watch(player); updateVisuals() end)
    connect(Players.PlayerRemoving,function(player)
        departing[player]=true; clearVisual(player); unwatch(player); retiring[player]=nil
        if locked and locked.player==player then locked=nil end
    end)
