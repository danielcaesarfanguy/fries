    local function changeWheel(point)
        local center=wheel.AbsolutePosition+wheel.AbsoluteSize/2
        local radius=wheel.AbsoluteSize.X/2
        if radius<=0 then return end
        local delta=point-center
        saturation=math.clamp(delta.Magnitude/radius,0,1)
        if delta.Magnitude>0.1 then hue=(math.atan2(delta.Y,delta.X)/(2*math.pi))%1 end
        applyHSV()
    end
    local function changeBrightness(point)
        if brightnessHit.AbsoluteSize.X<=0 then return end
        brightness=math.clamp((point.X-brightnessHit.AbsolutePosition.X)/brightnessHit.AbsoluteSize.X,0,1)
        applyHSV()
    end
    local function startColorDrag(input,kind)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        local point=Vector2.new(input.Position.X,input.Position.Y)
        if kind=="wheel" then
            local delta=point-(wheel.AbsolutePosition+wheel.AbsoluteSize/2)
            if delta.Magnitude>wheel.AbsoluteSize.X/2 then return end
        end
        if hex:IsFocused() then hex:ReleaseFocus() end
        colorDrag={kind=kind,touch=input.UserInputType==Enum.UserInputType.Touch and input or nil}
        if kind=="wheel" then changeWheel(point) else changeBrightness(point) end
    end
    connect(wheelHit.InputBegan,function(input) startColorDrag(input,"wheel") end)
