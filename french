    RunService:BindToRenderStep(BIND,Enum.RenderPriority.Camera.Value+1,function(dt)
        if unloaded or not ready then return end
        local camera=workspace.CurrentCamera
        beam.Visible=false; dot.Visible=false; ring.Visible=false
        if not camera then locked=nil; return end
        local center=camera.ViewportSize/2
        ring.Position=UDim2.fromOffset(center.X,center.Y)
        ring.Size=UDim2.fromOffset(cfg.FOV*2,cfg.FOV*2)
        ring.Visible=cfg.Aim and cfg.Circle
        local h=me.Character and me.Character:FindFirstChildOfClass("Humanoid")
        if not cfg.Aim or not h or h.Health<=0 or Input:GetFocusedTextBox() or not Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            locked=nil; gui:SetAttribute("LockedUserId",0)
            setStatus(cfg.Aim and "Hold right mouse to lock" or "Aim paused",false); return
        end
        if camera.CameraType==Enum.CameraType.Scriptable then
            locked=nil; gui:SetAttribute("LockedUserId",0)
            setStatus("Custom scripted camera · aim paused",false); return
        end
        local ignored={camera,folder}
        if me.Character then table.insert(ignored,me.Character) end
        rayParams.FilterDescendantsInstances=ignored
        if locked then
            if not eligible(locked.player) then
                locked=nil
            elseif not scorePoint(camera,center,locked.player,locked.part) then
                local replacement=choosePart(camera,center,locked.player)
                if replacement then locked.part=replacement else locked=nil end
            end
        end
        if not locked then locked=findTarget(camera,center) end
        if not locked then gui:SetAttribute("LockedUserId",0); setStatus("No valid target inside FOV",false); return end
        local offset=locked.part.Position-camera.CFrame.Position
        if offset.Magnitude<0.01 then return end
        local rate=3+37*(1-cfg.Smooth/100)^2
        local alpha=cfg.Smooth==0 and 1 or 1-math.exp(-rate*dt)
        camera.CFrame=camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position,locked.part.Position),alpha)
        gui:SetAttribute("LockedUserId",locked.player.UserId)
        gui:SetAttribute("LockedPart",locked.part.Name)
        setStatus(locked.player.DisplayName.."  /  "..locked.part.Name,true)
        local projected,onScreen=camera:WorldToViewportPoint(locked.part.Position)
        if cfg.Line and onScreen then
            local point=Vector2.new(projected.X,projected.Y)
            local delta=point-center
            local midpoint=(point+center)/2
            beam.Position=UDim2.fromOffset(midpoint.X,midpoint.Y)
            beam.Size=UDim2.fromOffset(math.max(delta.Magnitude,1),2)
            beam.Rotation=math.deg(math.atan2(delta.Y,delta.X))
            dot.Position=UDim2.fromOffset(point.X,point.Y)
            beam.Visible=true; dot.Visible=true
        end
    end)
