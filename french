    local function eligible(player)
        if player==me or departing[player] or player.Parent~=Players then return false end
        if cfg.Team and not me.Neutral and not player.Neutral and me.Team==player.Team then return false end
        local c=player.Character
        if not c or c==retiring[player] then return false end
        local h=c:FindFirstChildOfClass("Humanoid")
        local root=c:FindFirstChild("HumanoidRootPart")
        return h and h.Health>0 and root and root:IsA("BasePart")
    end
    updateVisuals=function()
        if unloaded then return end
        local active={}
        local myRoot=me.Character and me.Character:FindFirstChild("HumanoidRootPart")
        for _,player in ipairs(Players:GetPlayers()) do
            if cfg.ESP and eligible(player) then
                active[player]=true
                local c=player.Character
                local anchor=c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
                local v=visuals[player]
                if v and (v.character~=c or v.billboard.Adornee~=anchor) then clearVisual(player); v=nil end
                if not v then
                    local highlight=create("Highlight",folder,{
                        Adornee=c,FillColor=cfg.ESPFillColor,OutlineColor=cfg.ESPOutlineColor,
                        FillTransparency=0.9,OutlineTransparency=0.12,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
                    })
